{
  "name": "qmd-vault-search",
  "version": "2.1.4",
  "description": "Search your vault with its own QMD index: hybrid keyword and semantic search, deep search on demand, and related notes.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "test:unit": "vitest run",
    "check:mobile": "node scripts/check-mobile-compat.mjs",
    "test:e2e": "wdio run ./wdio.conf.mts",
    "test:e2e:fast": "OBSIDIAN_VERSIONS=latest/latest OBSIDIAN_E2E_TARGET=desktop wdio run ./wdio.conf.mts"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "qmd",
    "search",
    "bm25",
    "vector",
    "semantic-search"
  ],
  "author": "Ding Zheng Yuan",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^0.14.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.14.0",
    "@wdio/cli": "^9.33.1",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.33.1",
    "@wdio/mocha-framework": "^9.33.1",
    "@wdio/spec-reporter": "^9.33.1",
    "esbuild": "^0.21.5",
    "eslint": "^9.17.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "mocha": "^10.8.2",
    "obsidian": "^1.14.4",
    "tslib": "^2.6.3",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8",
    "wdio-obsidian-reporter": "^3.5.0",
    "wdio-obsidian-service": "^3.5.0",
    "yaml": "^2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dingzy53/obsidian-qmd.git"
  }
}
