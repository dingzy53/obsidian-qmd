{
  "name": "qmd-vault-search",
  "version": "2.0.0",
  "description": "Search your vault with its own QMD index: hybrid keyword and semantic search, deep search on demand, and related notes.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "deploy": "npm run build && node scripts/deploy.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "qmd",
    "search",
    "bm25",
    "vector",
    "semantic-search"
  ],
  "author": "Ding",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^0.14.0",
    "@types/node": "^20.14.0",
    "esbuild": "^0.21.5",
    "eslint": "^9.17.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.13.0",
    "tslib": "^2.6.3",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8",
    "yaml": "^2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dingzy53/obsidian-qmd.git"
  }
}
